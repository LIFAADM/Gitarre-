{
  "name": "guitarcoach",
  "private": true,
  "version": "0.1.0",
  "description": "GuitarCoach – persönliche Gitarren-Lernapp (PWA) für klassische Gitarre",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "cap:sync": "npm run build && cap sync",
    "cap:ios": "cap open ios",
    "audio:fixtures": "node scripts/generate-test-audio.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@coderline/alphatab": "^1.8.4",
    "@coderline/alphatab-vite": "^1.8.4",
    "@eslint/js": "^10.0.1",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
